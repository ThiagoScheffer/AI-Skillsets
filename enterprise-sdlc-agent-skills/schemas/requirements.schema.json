{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements Registry",
  "type": "object",
  "required": [
    "requirements"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(BUS|USR|FR|NFR)-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "business",
              "user",
              "functional",
              "nonfunctional"
            ]
          },
          "title": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "approved",
              "superseded",
              "rejected"
            ]
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "may"
            ]
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3,}$"
            }
          },
          "verification": {
            "type": [
              "string",
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}